# ---------------------------------------------------------------------------
# Meridian Health — Backend Environment Variable Template
#
# NONE of these are used by this front-end prototype — it runs entirely on
# mock data with no environment configuration required. This file documents
# what a REAL BACKEND integration would need. All values below are
# placeholders; never commit real secrets to source control.
#
# These belong on the BACKEND only. Nothing in this list should ever be
# prefixed with NEXT_PUBLIC_ or otherwise exposed to frontend/browser code.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/meridian_health
DATABASE_POOL_SIZE=10

# --- Auth --------------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-value
JWT_SIGNING_KEY=replace-with-a-long-random-value
MFA_PROVIDER_API_KEY=

# --- Payments ------------------------------------------------------------
# Which provider is active for this deployment.
PAYMENT_PROVIDER=stripe               # stripe | flutterwave | dpo_pay

# Provider secret/server-side API key (NEVER the publishable/client key here).
PAYMENT_PROVIDER_SECRET_KEY=

# Merchant/business account identifier used for settlement routing.
MERCHANT_ACCOUNT=acct_replace_me

# Currency the payment provider settles funds into the business bank account.
SETTLEMENT_CURRENCY=USD

# Backend URL registered with the payment provider to receive webhook events.
WEBHOOK_ENDPOINT=https://api.meridianhealth.example/webhooks/payments

# Secret used to verify webhook signatures from the payment provider.
PAYMENT_WEBHOOK_SIGNING_SECRET=

# --- File Storage (prescription uploads, product imagery) -----------------
FILE_STORAGE_BUCKET=meridian-health-prod
FILE_STORAGE_REGION=ap-south-1
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=

# --- International Logistics Provider ---------------------------------------
LOGISTICS_PROVIDER_API_KEY=
LOGISTICS_PROVIDER_ACCOUNT_ID=

# --- Notifications (email/SMS) -----------------------------------------------
NOTIFICATION_EMAIL_PROVIDER_API_KEY=
NOTIFICATION_SMS_PROVIDER_API_KEY=

# --- Observability -------------------------------------------------------
ERROR_TRACKING_DSN=
