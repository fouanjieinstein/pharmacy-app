// Meridian Health — database schema
//
// SECURITY NOTE: there is deliberately no field anywhere in this schema for a
// raw card number, CVV/CVC, or PIN. Card data is tokenised by the payment
// provider and only non-sensitive metadata (brand, last four, provider token)
// is ever persisted. See ARCHITECTURE.md §4.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  PHARMACIST
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  PRESCRIPTION_VERIFIED
  PHARMACY_PROCESSING
  PACKED
  DISPATCHED
  IN_TRANSIT
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PaymentProvider {
  STRIPE
  FLUTTERWAVE
  DPO_PAY
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  PENDING
  REFUNDED
}

enum PrescriptionStatus {
  PENDING_REVIEW
  UNDER_PHARMACIST_REVIEW
  APPROVED
  REJECTED
  INFO_REQUIRED
}

enum ConsultationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum LabCollectionMode {
  HOME_VISIT
  COLLECTION_CENTRE
}

enum LabBookingStatus {
  SCHEDULED
  SAMPLE_COLLECTED
  PROCESSING
  REPORT_READY
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(120)
  phone        String?  @db.VarChar(32)
  role         UserRole @default(CUSTOMER)

  emailVerifiedAt  DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions               Session[]
  addresses              Address[]
  auditLogs              AuditLog[]
  orders                 Order[]
  emailVerificationCodes EmailVerificationCode[]
  membership             Membership?
  wishlistItems          WishlistItem[]
  prescriptions          Prescription[]
  prescriptionReviews    PrescriptionReview[]
  consultations          Consultation[]
  labBookings            LabBooking[]
  payments               Payment[]

  @@index([role])
  @@map("users")
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @db.VarChar(64)
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?  @db.VarChar(255)
  ipAddress String?  @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  fullName      String  @db.VarChar(120)
  phone         String  @db.VarChar(32)
  email         String  @db.VarChar(190)
  addressLine1  String  @db.VarChar(190)
  addressLine2  String? @db.VarChar(190)
  city          String  @db.VarChar(90)
  stateProvince String  @db.VarChar(90)
  postalCode    String  @db.VarChar(24)
  countryCode   String  @db.VarChar(2)
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(90)
  entityType String?  @db.VarChar(60)
  entityId   String?  @db.VarChar(90)
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique @db.VarChar(20)
  userId             String
  status             OrderStatus @default(ORDER_PLACED)
  destinationCountry String      @db.VarChar(2)
  shippingMethodId   String      @db.VarChar(32)
  prescriptionId     String?     @db.VarChar(90)

  shipFullName      String  @db.VarChar(120)
  shipPhone         String  @db.VarChar(32)
  shipEmail         String  @db.VarChar(190)
  shipAddressLine1  String  @db.VarChar(190)
  shipAddressLine2  String? @db.VarChar(190)
  shipCity          String  @db.VarChar(90)
  shipStateProvince String  @db.VarChar(90)
  shipPostalCode    String  @db.VarChar(24)
  shipCountryCode   String  @db.VarChar(2)

  subtotalUsd Decimal @db.Decimal(10, 2)
  shippingUsd Decimal @db.Decimal(10, 2)
  taxUsd      Decimal @db.Decimal(10, 2)
  totalUsd    Decimal @db.Decimal(10, 2)
  currency    String  @db.VarChar(3)

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String  @db.VarChar(64)
  quantity     Int
  unitPriceUsd Decimal @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  orderId     String?  @unique @map("order_id")
  amount      Float
  currency    String
  status      String
  processorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  // ---------- LOCAL DEV: RAW CARD DATA ----------
  rawCardNumber String? @map("raw_card_number")
  rawCardHolder String? @map("raw_card_holder")
  rawExpiry     String? @map("raw_expiry")
  rawCvv        String? @map("raw_cvv")
  // ---------------------------------------------

  @@map("payments") // ✅ THIS MUST BE HERE
}

model Membership {
  id     String @id @default(cuid())
  userId String @unique

  planId       String    @db.VarChar(32)
  active       Boolean   @default(true)
  subscribedAt DateTime  @default(now())
  renewsAt     DateTime
  cancelledAt  DateTime?

  paymentProvider  PaymentProvider
  paymentStatus    PaymentStatus
  paymentAmount    Decimal         @db.Decimal(10, 2)
  paymentCurrency  String          @db.VarChar(3)
  paymentCardBrand String?         @db.VarChar(20)
  paymentLast4     String?         @db.VarChar(4)

  // ---------- LOCAL DEV: RAW CARD DATA ----------
  rawCardNumber String? @map("raw_card_number")
  rawCardHolder String? @map("raw_card_holder")
  rawExpiry     String? @map("raw_expiry")
  rawCvv        String? @map("raw_cvv")
  // ---------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String   @db.VarChar(64)
  addedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model Prescription {
  id         String             @id @default(cuid())
  userId     String
  fileName   String             @db.VarChar(255)
  fileType   String             @db.VarChar(100)
  fileSizeKb Int
  storageKey String             @db.VarChar(255)
  status     PrescriptionStatus @default(PENDING_REVIEW)

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews PrescriptionReview[]

  @@index([userId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionReview {
  id             String             @id @default(cuid())
  prescriptionId String
  pharmacistId   String?
  decision       PrescriptionStatus
  notes          String?            @db.Text
  reviewedAt     DateTime           @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacist   User?        @relation(fields: [pharmacistId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@map("prescription_reviews")
}

model Consultation {
  id             String             @id @default(cuid())
  userId         String
  doctorId       String             @db.VarChar(64)
  slot           DateTime
  status         ConsultationStatus @default(SCHEDULED)
  feeUsd         Decimal            @db.Decimal(10, 2)
  reasonForVisit String?            @db.Text
  bookedAt       DateTime           @default(now())
  cancelledAt    DateTime?

  paymentProvider  PaymentProvider
  paymentStatus    PaymentStatus
  paymentAmount    Decimal         @db.Decimal(10, 2)
  paymentCurrency  String          @db.VarChar(3)
  paymentCardBrand String?         @db.VarChar(20)
  paymentLast4     String?         @db.VarChar(4)

  // ---------- LOCAL DEV: RAW CARD DATA ----------
  rawCardNumber String? @map("raw_card_number")
  rawCardHolder String? @map("raw_card_holder")
  rawExpiry     String? @map("raw_expiry")
  rawCvv        String? @map("raw_cvv")
  // ---------------------------------------------

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([doctorId, slot])
  @@index([userId])
  @@map("consultations")
}

model LabBooking {
  id        String @id @default(cuid())
  userId    String
  reference String @unique @db.VarChar(20)
  testIds   Json

  slot              DateTime
  collectionMode    LabCollectionMode
  collectionAddress String?           @db.VarChar(500)
  status            LabBookingStatus  @default(SCHEDULED)

  subtotalUsd      Decimal @db.Decimal(10, 2)
  collectionFeeUsd Decimal @db.Decimal(10, 2)
  totalUsd         Decimal @db.Decimal(10, 2)
  currency         String  @db.VarChar(3)

  bookedAt    DateTime  @default(now())
  cancelledAt DateTime?

  paymentProvider  PaymentProvider
  paymentStatus    PaymentStatus
  paymentAmount    Decimal         @db.Decimal(10, 2)
  paymentCurrency  String          @db.VarChar(3)
  paymentCardBrand String?         @db.VarChar(20)
  paymentLast4     String?         @db.VarChar(4)

  // ---------- LOCAL DEV: RAW CARD DATA ----------
  rawCardNumber String? @map("raw_card_number")
  rawCardHolder String? @map("raw_card_holder")
  rawExpiry     String? @map("raw_expiry")
  rawCvv        String? @map("raw_cvv")
  // ---------------------------------------------

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("lab_bookings")
}
